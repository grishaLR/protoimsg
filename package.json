{
  "name": "protoimsg",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "turbo dev --filter=!@protoimsg/desktop --filter=!@protoimsg/mobile",
    "dev:up": "docker compose up -d && docker compose wait postgres redis && pnpm --filter @protoimsg/server db:migrate && turbo dev --filter=!@protoimsg/desktop --filter=!@protoimsg/mobile",
    "dev:up:all": "docker compose up -d --wait && pnpm --filter @protoimsg/server db:migrate && turbo dev --filter=!@protoimsg/desktop --filter=!@protoimsg/mobile",
    "dev:mobile": "pnpm --filter @protoimsg/mobile dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "lint:fix": "turbo run lint -- --fix",
    "format": "prettier --write \"**/*.{ts,tsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,json,md}\"",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "validate:lexicon": "pnpm --filter @protoimsg/lexicon codegen:check",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.6.1",
    "@commitlint/config-conventional": "^19.6.0",
    "@eslint/js": "^9.39.4",
    "eslint": "^9.18.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.4.3",
    "prettier": "^3.8.3",
    "turbo": "^2.9.14",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.59.4",
    "vitest": "^4.1.7"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md}": "prettier --write",
    "packages/lexicon/schemas/**/*.json": "pnpm validate:lexicon"
  },
  "pnpm": {
    "overrides": {
      "typescript": "$typescript",
      "minimatch": ">=10.2.3",
      "qs": ">=6.14.2",
      "rollup": ">=4.59.0",
      "undici": ">=7.24.0"
    }
  },
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=22"
  }
}
