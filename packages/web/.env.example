# protoimsg Web Client
# No env vars needed for development — Vite proxy handles API/WS routing.
# For production, set VITE_API_URL to the backend URL.
# VITE_API_URL=https://your-backend.example.com

# PDS URL for account creation (defaults to https://pds.protoimsg.app)
# VITE_PDS_URL=https://pds.protoimsg.app

# Feature flag: set to 'false' to hide full account creation signup
# VITE_SIGNUP_ENABLED=true

# Feature flag: set to 'true' to enable ProtoBuddy bot
# VITE_BOT_ENABLED=false

# Cloudflare Turnstile (optional — signup CAPTCHA widget, skipped when absent)
# VITE_TURNSTILE_SITE_KEY=

# Sentry (optional — error tracking disabled when absent)
# VITE_SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
