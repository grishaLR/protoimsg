{
  "name": "@protoimsg/server",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx watch --env-file=.env src/index.ts",
    "start": "node --env-file=.env dist/index.js",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit",
    "db:migrate": "tsx --env-file=.env src/db/migrate.ts",
    "test": "vitest run --coverage",
    "db:seed": "tsx --env-file=.env src/db/seed.ts",
    "db:seed-bans": "tsx --env-file=.env src/db/seed-global-bans.ts",
    "db:seed-allowlist": "tsx --env-file=.env src/db/seed-global-allowlist.ts"
  },
  "dependencies": {
    "@atproto/api": "^0.20.13",
    "@atproto/oauth-client-node": "^0.4.1",
    "@protoimsg/game-sim": "workspace:*",
    "@protoimsg/lexicon": "workspace:*",
    "@protoimsg/shared": "workspace:*",
    "@sentry/node": "^10.57.0",
    "cors": "^2.8.5",
    "expo-server-sdk": "^6.1.0",
    "express": "^4.21.2",
    "franc-min": "^6.2.0",
    "helmet": "^8.2.0",
    "ioredis": "^5.11.1",
    "livekit-server-sdk": "^2.15.4",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "postgres": "^3.4.9",
    "prom-client": "^15.1.3",
    "resend": "^6.12.4",
    "ws": "^8.21.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/ioredis": "^5.0.0",
    "@types/ws": "^8.5.14",
    "@vitest/coverage-v8": "^4.1.8",
    "pino-pretty": "^13.1.3",
    "tsx": "^4.22.4",
    "typescript": "^5.7.3",
    "vitest": "^4.1.8"
  }
}
